# Meta Model API (https://dev.meta.ai)
MODEL_API_KEY=
MUSE_MODEL=muse-spark-1.3

# WhatsApp Business Cloud API (developers.facebook.com > your app > WhatsApp > API Setup)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=pick-any-long-random-string
# For npm run webhook: App ID (App settings > Basic) and WhatsApp Business Account ID (API Setup)
WA_APP_ID=
WA_WABA_ID=
# App settings > Basic > App secret. When set, every webhook POST must carry a valid X-Hub-Signature-256.
WA_APP_SECRET=
# The number customers message, digits only with country code (used for wa.me shop links)
WA_DISPLAY_NUMBER=

# Control room login (user "mesa"). Required; ALLOW_OPEN_CONTROL_ROOM=1 skips it for local development only.
CONTROL_PASSWORD=
PORT=8787
PUBLIC_URL=http://localhost:8787
